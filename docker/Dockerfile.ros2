FROM osrf/ros:jazzy-desktop-full AS base

FROM base AS userspace

ARG USERNAME=$USERNAME
ARG USER_ID=$USER_ID
ARG GROUP_ID=$GROUP_ID

# Delete user if it exists in container (e.g Ubuntu Noble: ubuntu)
RUN if id -u $USER_ID ; then userdel `id -un $USER_ID` ; fi

# Create the user
RUN groupadd --gid $GROUP_ID $USERNAME \
    && useradd --uid $USER_ID --gid $GROUP_ID -m $USERNAME \
    #
    # [Optional] Add sudo support. Omit if you don't need to install software after connecting.
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME
RUN apt-get update && apt-get upgrade -y
RUN apt-get install -y python3-pip
ENV SHELL /bin/bash

FROM userspace AS dependencies

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
        ros-jazzy-ros2-control \
        ros-jazzy-ros2-controllers \
        ros-jazzy-moveit \
        ros-jazzy-moveit-ros-control-interface \
        ros-jazzy-joint-state-publisher \
        ros-jazzy-joint-state-publisher-gui \
        ros-jazzy-ros-gz \
        ros-jazzy-gz-ros2-control \
        && rm -rf /var/lib/apt/lists/*

FROM dependencies AS setup

RUN echo "source /opt/ros/jazzy/setup.bash" >> /home/${USERNAME}/.bashrc

USER ${USERNAME}

ENTRYPOINT [""]
CMD ["/bin/bash"]
