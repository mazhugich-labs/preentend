#!/usr/bin/env python3
"""Wait until MoveIt's planning action server is available."""
import argparse
import sys

from moveit_msgs.action import MoveGroup
import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--timeout', type=float, default=120.0)
    parser.add_argument('--action', default='/move_action')
    args = parser.parse_args()
    if args.timeout <= 0:
        parser.error('--timeout must be positive')
    rclpy.init(args=[])
    node = Node('wait_for_move_group')
    client = ActionClient(node, MoveGroup, args.action)
    try:
        if not client.wait_for_server(timeout_sec=args.timeout):
            print(f'Timed out waiting for {args.action}', file=sys.stderr, flush=True)
            return 1
        return 0
    finally:
        client.destroy()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    sys.exit(main())
