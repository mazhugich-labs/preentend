<!-- URDF for M-20/25-18D (M-20iD/25) -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro
    name="m20_25_18d"
    params="package_name:='' prefix=''
            parent
            *origin"
  >

    <xacro:property name="j1_lower_limit" value="${radians(-185)}" />
    <xacro:property name="j2_lower_limit" value="${radians(-100)}" />
    <xacro:property name="j3_lower_limit" value="${radians(-90)}" />
    <xacro:property name="j4_lower_limit" value="${radians(-200)}" />
    <xacro:property name="j5_lower_limit" value="${radians(-179.999)}" />
    <xacro:property name="j6_lower_limit" value="${radians(-450)}" />

    <xacro:property name="j1_upper_limit" value="${radians(185)}" />
    <xacro:property name="j2_upper_limit" value="${radians(160)}" />
    <xacro:property name="j3_upper_limit" value="${radians(220)}" />
    <xacro:property name="j4_upper_limit" value="${radians(200)}" />
    <xacro:property name="j5_upper_limit" value="${radians(179.999)}" />
    <xacro:property name="j6_upper_limit" value="${radians(450)}" />

    <xacro:property name="j1_effort_limit" value="7000" />
    <xacro:property name="j2_effort_limit" value="8000" />
    <xacro:property name="j3_effort_limit" value="4000" />
    <xacro:property name="j4_effort_limit" value="300" />
    <xacro:property name="j5_effort_limit" value="300" />
    <xacro:property name="j6_effort_limit" value="200" />

    <xacro:property name="j1_velocity_limit" value="${radians(210)}" />
    <xacro:property name="j2_velocity_limit" value="${radians(210)}" />
    <xacro:property name="j3_velocity_limit" value="${radians(265)}" />
    <xacro:property name="j4_velocity_limit" value="${radians(420)}" />
    <xacro:property name="j5_velocity_limit" value="${radians(420)}" />
    <xacro:property name="j6_velocity_limit" value="${radians(720)}" />

    <!-- links -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/visual/base.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/collision/base.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 45.8" />
        <origin xyz="-.0767  .00288  .109" />
        <inertia
          ixx=" .497"
          ixy=" .029"
          ixz=" .0137"
          iyy=" 1.1"
          iyz=" .0000537"
          izz=" 1.16"
        />
      </inertial>
    </link>

    <link name="${prefix}link_1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/visual/j1.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/collision/j1.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 62.8" />
        <origin xyz=" .0158 -.0106 -.0831" />
        <inertia
          ixx=" 1.35"
          ixy=" .133"
          ixz="-.0417"
          iyy=" 1.11"
          iyz="-.108"
          izz=" 1.3"
        />
      </inertial>
    </link>

    <link name="${prefix}link_2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/visual/j2.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/collision/j2.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 65.8" />
        <origin xyz="-.0343 -.172  .38" />
        <inertia
          ixx=" 4.86"
          ixy="-.0809"
          ixz=" .0453"
          iyy=" 4.98"
          iyz="-.118"
          izz=" .536"
        />
      </inertial>
    </link>

    <link name="${prefix}link_3">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/visual/j3.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/collision/j3.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 52.9" />
        <origin xyz=" .134  .00796  .103" />
        <inertia
          ixx=" .901"
          ixy="-.0784"
          ixz="-.294"
          iyy=" 1.13"
          iyz="-.0385"
          izz=" 1.06"
        />
      </inertial>
    </link>

    <link name="${prefix}link_4">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/visual/j4.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/collision/j4.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 20.2" />
        <origin xyz=" .586 -.0481 -.000358" />
        <inertia
          ixx=" .0769"
          ixy=" .053"
          ixz="-.00106"
          iyy=" .647"
          iyz="-.0000313"
          izz=" .656"
        />
      </inertial>
    </link>

    <link name="${prefix}link_5">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/visual/j5.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/collision/j5.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 1.98" />
        <origin xyz=" .0276 -.0121  .000000522" />
        <inertia
          ixx=" .00394"
          ixy="-.000785"
          ixz=" .0000000339"
          iyy=" .00462"
          iyz=" .00000000332"
          izz=" .0041"
        />
      </inertial>
    </link>

    <link name="${prefix}link_6">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/visual/j6.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m20_description/meshes/m20_25_18d/collision/j6.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" .558" />
        <origin xyz=" .0581 -.000000509  .000000147" />
        <inertia
          ixx=" .000585"
          ixy="-.00000000703"
          ixz=" .0000000019"
          iyy=" .000433"
          iyz=" .0000000227"
          izz=" .000433"
        />
      </inertial>
    </link>

    <!-- joints -->
    <joint name="${prefix}link_1_joint" type="revolute">
      <origin xyz=" 0  0  .425" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}link_1" />
      <axis xyz=" 0  0  1" />
      <limit
        lower="${j1_lower_limit}"
        upper="${j1_upper_limit}"
        effort="${j1_effort_limit}"
        velocity="${j1_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}link_2_joint" type="revolute">
      <origin xyz=" .075  0  0" rpy="0 0 0" />
      <parent link="${prefix}link_1" />
      <child link="${prefix}link_2" />
      <axis xyz=" 0  1  0" />
      <limit
        lower="${j2_lower_limit}"
        upper="${j2_upper_limit}"
        effort="${j2_effort_limit}"
        velocity="${j2_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}link_3_joint" type="revolute">
      <origin xyz=" 0  0  .84" rpy="0 0 0" />
      <parent link="${prefix}link_2" />
      <child link="${prefix}link_3" />
      <axis xyz=" 0 -1  0" />
      <limit
        lower="${j3_lower_limit}"
        upper="${j3_upper_limit}"
        effort="${j3_effort_limit}"
        velocity="${j3_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}link_4_joint" type="revolute">
      <origin xyz=" 0  0  .215" rpy="0 0 0" />
      <parent link="${prefix}link_3" />
      <child link="${prefix}link_4" />
      <axis xyz="-1  0  0" />
      <limit
        lower="${j4_lower_limit}"
        upper="${j4_upper_limit}"
        effort="${j4_effort_limit}"
        velocity="${j4_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}link_5_joint" type="revolute">
      <origin xyz=" .89  0  0" rpy="0 0 0" />
      <parent link="${prefix}link_4" />
      <child link="${prefix}link_5" />
      <axis xyz=" 0 -1  0" />
      <limit
        lower="${j5_lower_limit}"
        upper="${j5_upper_limit}"
        effort="${j5_effort_limit}"
        velocity="${j5_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}link_6_joint" type="revolute">
      <origin xyz=" 0  0  0" rpy="0 0 0" />
      <parent link="${prefix}link_5" />
      <child link="${prefix}link_6" />
      <axis xyz="-1  0  0" />
      <limit
        lower="${j6_lower_limit}"
        upper="${j6_upper_limit}"
        effort="${j6_effort_limit}"
        velocity="${j6_velocity_limit}"
      />
    </joint>

    <!-- flange coords -->
    <link name="${prefix}flange" />
    <joint name="${prefix}flange_joint" type="fixed">
      <origin xyz=" .09  0  0" rpy="0 0 0" />
      <parent link="${prefix}link_6" />
      <child link="${prefix}flange" />
    </joint>

    <!-- Attach to parent -->
    <joint name="${prefix}base_link_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}base_link" />
    </joint>
  </xacro:macro>
</robot>
