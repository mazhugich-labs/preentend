<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Attach to the camera body; Gazebo cameras look along +X. -->
  <xacro:macro name="mock_camera_gazebo" params="prefix topic_prefix update_rate:=15 color_width:=1280 color_height:=720 depth_width:=1280 depth_height:=720 depth_near:=0.28 depth_far:=10.0">
    <gazebo reference="${prefix}camera_link">
      <sensor name="${prefix}camera_color" type="camera">
        <pose>0.0125 0 0 0 0 0</pose>
        <always_on>true</always_on><update_rate>${update_rate}</update_rate>
        <topic>${topic_prefix}/color/image</topic>
        <camera>
          <optical_frame_id>${prefix}camera_color_optical_frame</optical_frame_id>
          <camera_info_topic>${topic_prefix}/color/camera_info</camera_info_topic>
          <horizontal_fov>${69 * pi / 180}</horizontal_fov>
          <image><width>${color_width}</width><height>${color_height}</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>${depth_far}</far></clip>
        </camera>
      </sensor>
      <sensor name="${prefix}camera_depth" type="depth_camera">
        <pose>0.0125 0 0 0 0 0</pose>
        <always_on>true</always_on><update_rate>${update_rate}</update_rate>
        <topic>${topic_prefix}/depth</topic>
        <camera>
          <optical_frame_id>${prefix}camera_depth_optical_frame</optical_frame_id>
          <camera_info_topic>${topic_prefix}/depth/camera_info</camera_info_topic>
          <horizontal_fov>${87 * pi / 180}</horizontal_fov>
          <image><width>${depth_width}</width><height>${depth_height}</height><format>R_FLOAT32</format></image>
          <clip><near>${depth_near}</near><far>${depth_far}</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
