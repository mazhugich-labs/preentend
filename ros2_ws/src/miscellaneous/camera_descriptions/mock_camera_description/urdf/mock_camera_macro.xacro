<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Body origin at its center; +X is forward, +Y left and +Z up. -->
  <xacro:macro name="mock_camera" params="prefix parent *origin">
    <link name="${prefix}camera_link">
      <visual>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
        <material name="${prefix}camera_body"><color rgba="0.12 0.12 0.12 1"/></material>
      </visual>
      <collision><geometry><box size="0.025 0.09 0.025"/></geometry></collision>
      <inertial>
        <mass value="0.075"/>
        <inertia ixx="0.00005453125" ixy="0" ixz="0" iyy="0.0000078125" iyz="0" izz="0.00005453125"/>
      </inertial>
    </link>
    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${parent}"/><child link="${prefix}camera_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <!-- Approximate coincident optical centers at the front of the housing. -->
    <!-- Gazebo point clouds use +X forward; images use the ROS optical frame. -->
    <link name="${prefix}camera_depth_frame"/>
    <joint name="${prefix}camera_depth_joint" type="fixed">
      <parent link="${prefix}camera_link"/><child link="${prefix}camera_depth_frame"/>
      <origin xyz="0.0125 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}camera_depth_optical_frame"/>
    <joint name="${prefix}camera_depth_optical_joint" type="fixed">
      <parent link="${prefix}camera_depth_frame"/><child link="${prefix}camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <link name="${prefix}camera_color_optical_frame"/>
    <joint name="${prefix}camera_color_optical_joint" type="fixed">
      <parent link="${prefix}camera_link"/><child link="${prefix}camera_color_optical_frame"/>
      <origin xyz="0.0125 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:macro>
</robot>
