#!/usr/bin/env python3
"""Select a robot model for the running two-arm description."""

from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
import subprocess
import signal
import sys
import time

from ament_index_python.packages import get_package_share_directory
from python_qt_binding.QtCore import QTimer
from python_qt_binding.QtWidgets import (
    QApplication, QComboBox, QLabel, QPushButton, QVBoxLayout, QWidget,
)
import rclpy
from rcl_interfaces.msg import Parameter, ParameterType, ParameterValue
from rcl_interfaces.srv import SetParameters
from rclpy.node import Node


MODELS = (
    'lrmate25_19a', 'lrmate25_19afc', 'm20_25_18d', 'm20_35_18d',
    'kr16_r2010_2', 'kr20_r1820_2_e', 'kr35_r1840_3', 'kr35_r1840_3_hw',
    'kr30_r2100',
)
DIMENSIONS = (
    'separation', 'track_length', 'track_width', 'track_height',
    'carrier_length', 'carrier_width', 'carrier_height', 'travel',
)
DEFAULTS = ('4.0', '6.4', '0.4', '0.2', '0.4', '0.4', '0.4', '6.0')


def generate_description(model, dimensions):
    """Expand xacro without a shell, retaining the assembly dimensions."""
    description = Path(get_package_share_directory('preentend_description')) / 'robot' / (
        'preentend.urdf.xacro'
    )
    command = ['xacro', str(description), f'robot_model:={model}']
    command.extend(f'{name}:={value}' for name, value in dimensions.items())
    result = subprocess.run(command, capture_output=True, text=True, timeout=30, check=True)
    return result.stdout


class ModelSelector(Node):
    def __init__(self):
        super().__init__('robot_model_selector')
        self.declare_parameter('robot_model', 'kr30_r2100')
        self.dimensions = {}
        for name, default in zip(DIMENSIONS, DEFAULTS):
            self.declare_parameter(name, default)
            self.dimensions[name] = self.get_parameter(name).value
        self.current_model = self.get_parameter('robot_model').value
        self.client = self.create_client(SetParameters, 'robot_state_publisher/set_parameters')


class SelectorWindow(QWidget):
    def __init__(self, node):
        super().__init__()
        self.node = node
        self.executor = ThreadPoolExecutor(max_workers=1)
        self.expansion = None
        self.request = None
        self.pending_model = None
        self.deadline = None

        self.setWindowTitle('Robot model')
        self.setFixedSize(280, 120)
        layout = QVBoxLayout(self)
        layout.addWidget(QLabel('Robot model (both arms)'))
        self.models = QComboBox()
        self.models.addItems(MODELS)
        self.models.setCurrentText(node.current_model)
        layout.addWidget(self.models)
        self.load_button = QPushButton('Load')
        self.load_button.clicked.connect(self.load)
        layout.addWidget(self.load_button)
        self.status = QLabel(f'Current model: {node.current_model}')
        self.status.setWordWrap(True)
        layout.addWidget(self.status)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.poll)
        self.timer.start(50)

    def load(self):
        if not self.node.client.service_is_ready():
            self.status.setText('Robot state publisher is not available. Try again.')
            return
        self.pending_model = self.models.currentText()
        self.load_button.setEnabled(False)
        self.models.setEnabled(False)
        self.status.setText(f'Loading {self.pending_model}...')
        self.expansion = self.executor.submit(
            generate_description, self.pending_model, self.node.dimensions
        )

    def finish(self, message):
        self.status.setText(message)
        self.load_button.setEnabled(True)
        self.models.setEnabled(True)
        self.pending_model = None

    def poll(self):
        rclpy.spin_once(self.node, timeout_sec=0)
        if self.expansion is not None and self.expansion.done():
            try:
                description = self.expansion.result()
                parameter = Parameter(
                    name='robot_description',
                    value=ParameterValue(type=ParameterType.PARAMETER_STRING,
                                         string_value=description),
                )
                request = SetParameters.Request()
                request.parameters = [parameter]
                self.request = self.node.client.call_async(request)
                self.deadline = time.monotonic() + 10
            except Exception as exc:
                detail = exc.stderr if isinstance(exc, subprocess.CalledProcessError) else str(exc)
                self.finish(f'Could not load model: {detail}')
            finally:
                self.expansion = None
        if self.request is not None:
            if self.request.done():
                try:
                    response = self.request.result()
                    result = response.results[0]
                    if not result.successful:
                        self.finish(f'Could not load model: {result.reason}')
                    else:
                        self.node.current_model = self.pending_model
                        self.finish(f'Current model: {self.node.current_model}')
                except Exception as exc:
                    self.finish(f'Could not load model: {exc}')
                self.request = None
            elif time.monotonic() > self.deadline:
                self.node.client.remove_pending_request(self.request)
                self.request = None
                self.finish('The update timed out; check the robot state publisher.')

    def closeEvent(self, event):
        self.timer.stop()
        self.executor.shutdown(wait=False, cancel_futures=True)
        super().closeEvent(event)


def main():
    rclpy.init(args=sys.argv)
    node = ModelSelector()
    app = QApplication(sys.argv[:1])
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    window = SelectorWindow(node)
    window.show()
    try:
        app.exec()
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
