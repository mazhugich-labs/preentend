<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="end_effector" params="prefix">
        <link name="${prefix}eef_link">
            <inertial>
                <mass value="6.77123" />
                <origin xyz="0.139759 0 0.0966483" rpy="0 0 0" />
                <inertia ixx="0.083718" ixy="0" ixz="-0.0132461" iyy="0.0945958" iyz="0"
                    izz="0.0269596" />
            </inertial>
            <visual>
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/end_effector/mock_end_effector.stl" />
                </geometry>
                <material name="eef_link_material">
                    <color rgba="0.25 0.25 0.25 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/end_effector/mock_end_effector.stl" />
                </geometry>
            </collision>
        </link>

        <link name="${prefix}eef_tcp" />
        <joint name="${prefix}eef_tcp_joint" type="fixed">
            <origin xyz="0.22 0 0.12" />
            <parent link="${prefix}eef_link" />
            <child link="${prefix}eef_tcp" />
        </joint>
    </xacro:macro>
</robot>
