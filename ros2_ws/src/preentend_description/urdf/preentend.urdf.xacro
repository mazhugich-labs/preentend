<?xml version="1.0"?>
<robot name="preentend" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="mode" default="mock" />
  <xacro:arg name="controllers_file" default="" />

  <xacro:arg name="separation" default="4.0" />

  <xacro:arg name="travel" default="6.0" />

  <xacro:arg name="robot_arm_camera_update_rate" default="15" />
  <xacro:arg name="robot_arm_camera_color_width" default="1280" />
  <xacro:arg name="robot_arm_camera_color_height" default="720" />
  <xacro:arg name="robot_arm_camera_depth_width" default="640" />
  <xacro:arg name="robot_arm_camera_depth_height" default="480" />

  <xacro:include filename="preentend_macro.urdf.xacro" />
  <xacro:include filename="preentend_macro.ros2_control.xacro" />
  <xacro:include filename="preentend_macro.gazebo.xacro" />

  <link name="base_link" />

  <xacro:preentend_urdf parent="base_link" separation="$(arg separation)" travel="$(arg travel)" />
  <xacro:preentend_ros2_control mode="$(arg mode)" />
  <xacro:if value="${'$(arg mode)' == 'gazebo'}">
    <xacro:preentend_gazebo controllers_file="$(arg controllers_file)"
      robot_update_rate="$(arg robot_arm_camera_update_rate)"
      robot_color_width="$(arg robot_arm_camera_color_width)" robot_color_height="$(arg robot_arm_camera_color_height)"
      robot_depth_width="$(arg robot_arm_camera_depth_width)" robot_depth_height="$(arg robot_arm_camera_depth_height)" />
  </xacro:if>
</robot>
