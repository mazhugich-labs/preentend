<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Nominal D435 color and depth streams. camera_link is the depth origin;
       the color imager is 15 mm along +Y, as in the D435 frame macro.
       Use a topic_prefix such as /robot_1/camera. -->
  <xacro:macro name="camera_gazebo" params="prefix topic_prefix update_rate color_width color_height depth_width depth_height">
    <gazebo reference="${prefix}camera_link">
      <sensor name="${prefix}camera_color" type="camera">
        <pose>0 0.015 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <topic>${topic_prefix}/color/image</topic>
        <camera>
          <optical_frame_id>${prefix}camera_color_optical_frame</optical_frame_id>
          <camera_info_topic>${topic_prefix}/color/camera_info</camera_info_topic>
          <horizontal_fov>${69 * pi / 180}</horizontal_fov>
          <image>
            <width>${color_width}</width>
            <height>${color_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="${prefix}camera_depth" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <topic>${topic_prefix}/depth</topic>
        <camera>
          <optical_frame_id>${prefix}camera_depth_optical_frame</optical_frame_id>
          <camera_info_topic>${topic_prefix}/depth/camera_info</camera_info_topic>
          <horizontal_fov>${87 * pi / 180}</horizontal_fov>
          <image>
            <width>${depth_width}</width>
            <height>${depth_height}</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.28</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>