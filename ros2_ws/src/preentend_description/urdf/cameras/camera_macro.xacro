<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="camera" params="camera_model mode prefix parent *origin topic_prefix:='' update_rate:=0 color_width:=0 color_height:=0 depth_width:=0 depth_height:=0">
    <xacro:include filename="$(find preentend_description)/urdf/cameras/${camera_model}/${camera_model}_macro.xacro" ns="camera_model_description" />
    <xacro:camera_model_description.camera prefix="${prefix}" />
    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}camera_bottom_screw_frame" />
      <xacro:insert_block name="origin" />
    </joint>
    <xacro:if value="${mode == 'gazebo'}">
      <xacro:include filename="$(find preentend_description)/urdf/cameras/${camera_model}/${camera_model}.gazebo.xacro" ns="camera_model_gazebo" />
      <xacro:camera_model_gazebo.camera_gazebo prefix="${prefix}" topic_prefix="${topic_prefix}" update_rate="${update_rate}" color_width="${color_width}" color_height="${color_height}" depth_width="${depth_width}" depth_height="${depth_height}" />
    </xacro:if>
  </xacro:macro>
</robot>
