<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="external_axis" params="external_axis_model mode prefix parent *origin travel">
    <xacro:include filename="$(find preentend_description)/urdf/external_axes/${external_axis_model}/${external_axis_model}_macro.xacro" ns="axis_description" />
    <xacro:axis_description.external_axis prefix="${prefix}" travel="${float(travel)}" />
    <joint name="${prefix}ea_track_mount_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}ea_track_link" />
      <xacro:insert_block name="origin" />
    </joint>
    <xacro:if value="${mode == 'gazebo'}">
      <xacro:include filename="$(find preentend_description)/urdf/external_axes/${external_axis_model}/${external_axis_model}.gazebo.xacro" ns="axis_gazebo" />
      <xacro:axis_gazebo.external_axis_gazebo prefix="${prefix}" />
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="external_axis_control" params="external_axis_model prefix">
    <xacro:include filename="$(find preentend_description)/urdf/external_axes/${external_axis_model}/${external_axis_model}.ros2_control.xacro" ns="axis_control" />
    <xacro:axis_control.external_axis_control prefix="${prefix}" />
  </xacro:macro>
</robot>
