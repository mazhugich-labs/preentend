<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="preentend_groups.srdf.xacro" />

  <!-- Generate the model's collision matrix before expanding this macro. -->
  <xacro:macro name="preentend_moveit" params="robot_model collision_matrices_dir:='$(find preentend_moveit_config)/srdf/collision_matrices'">
    <xacro:include filename="${collision_matrices_dir}/${robot_model}.srdf.xacro" />
    <xacro:preentend_planning_groups />
    <xacro:preentend_collision_matrix />
  </xacro:macro>
</robot>
