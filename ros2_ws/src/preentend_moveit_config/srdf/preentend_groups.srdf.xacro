<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="preentend_planning_groups">
        <group name="robot_1">
            <chain base_link="base_link" tip_link="robot_1_eef_tcp" />
        </group>
        <group name="robot_2">
            <chain base_link="base_link" tip_link="robot_2_eef_tcp" />
        </group>
        <group name="robots">
            <group name="robot_1" />
            <group name="robot_2" />
        </group>
    </xacro:macro>
</robot>