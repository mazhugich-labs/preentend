#!/usr/bin/env python3
"""Fuse approximately synchronized camera clouds in a common TF frame."""

from collections import deque
import time

import numpy as np

from message_filters import ApproximateTimeSynchronizer, Subscriber
import rclpy
from rclpy.duration import Duration
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rclpy.time import Time
from sensor_msgs.msg import PointCloud2, PointField
from sensor_msgs_py.point_cloud2 import dtype_from_fields
from tf2_ros import Buffer, TransformException, TransformListener
from tf2_sensor_msgs.tf2_sensor_msgs import transform_points


def transform_cloud_data(cloud, transform):
    """Transform XYZ in compacted point records, preserving all other bytes."""
    xyz = {field.name: field for field in cloud.fields if field.name in ('x', 'y', 'z')}
    if set(xyz) != {'x', 'y', 'z'} or any(
            field.count != 1 or field.datatype not in (PointField.FLOAT32, PointField.FLOAT64)
            for field in xyz.values()):
        raise ValueError('cloud needs scalar float x, y and z fields')
    row_bytes = cloud.width * cloud.point_step
    if cloud.row_step < row_bytes or len(cloud.data) < cloud.row_step * cloud.height:
        raise ValueError('invalid point cloud data or row stride')
    dtype = dtype_from_fields(cloud.fields, point_step=cloud.point_step)
    dtype = dtype.newbyteorder('>' if cloud.is_bigendian else '<')
    data = bytearray().join(
        cloud.data[row * cloud.row_step:row * cloud.row_step + row_bytes]
        for row in range(cloud.height))
    points = np.ndarray(shape=(cloud.width * cloud.height,), dtype=dtype, buffer=data)
    coordinates = np.column_stack((points['x'], points['y'], points['z']))
    coordinates = transform_points(coordinates, transform.transform)
    for index, field in enumerate(('x', 'y', 'z')):
        points[field] = coordinates[:, index]
    return data


class CloudFusion(Node):
    def __init__(self):
        super().__init__('cloud_fusion')
        self.declare_parameter('input_topics', ['/robot_1/camera/depth/points',
                                                '/robot_2/camera/depth/points'])
        self.declare_parameter('output_topic', '/fused_points')
        self.declare_parameter('target_frame', 'base_link')
        self.declare_parameter('sync_slop', 0.1)
        self.declare_parameter('queue_size', 10)
        self.declare_parameter('transform_wait', 0.5)
        topics = self.get_parameter('input_topics').value
        self.target = self.get_parameter('target_frame').value
        slop = self.get_parameter('sync_slop').value
        queue_size = self.get_parameter('queue_size').value
        self.transform_wait = self.get_parameter('transform_wait').value
        if len(topics) < 2 or len(set(topics)) != len(topics) or not self.target:
            raise ValueError('input_topics must contain at least two distinct topics and target_frame must not be empty')
        if slop <= 0 or queue_size < 1 or self.transform_wait <= 0:
            raise ValueError('sync_slop, queue_size and transform_wait must be positive')
        self.buffer = Buffer()
        self.listener = TransformListener(self.buffer, self)
        self.publisher = self.create_publisher(PointCloud2, self.get_parameter('output_topic').value,
                                               qos_profile_sensor_data)
        self.subscribers = [Subscriber(self, PointCloud2, topic, qos_profile=qos_profile_sensor_data)
                            for topic in topics]
        self.synchronizer = ApproximateTimeSynchronizer(self.subscribers, queue_size, slop)
        self.synchronizer.registerCallback(self.enqueue)
        self.pending = deque(maxlen=queue_size)
        self.timer = self.create_timer(0.02, self.process_pending)
        self.get_logger().info(f'Fusing {topics} in {self.target}')

    def enqueue(self, *clouds):
        self.pending.append((time.monotonic(), clouds))

    def process_pending(self):
        if not self.pending:
            return
        queued_at, clouds = self.pending[0]
        try:
            transforms = [self.buffer.lookup_transform(self.target, cloud.header.frame_id,
                                                       Time.from_msg(cloud.header.stamp),
                                                       timeout=Duration()) for cloud in clouds]
        except TransformException as exc:
            if time.monotonic() - queued_at >= self.transform_wait:
                self.pending.popleft()
                self.get_logger().warning(f'Dropping cloud pair: {exc}', throttle_duration_sec=5.0)
            return
        self.pending.popleft()
        try:
            first = clouds[0]
            schema = [(f.name, f.offset, f.datatype, f.count) for f in first.fields]
            if any([(f.name, f.offset, f.datatype, f.count) for f in c.fields] != schema
                   or c.point_step != first.point_step or c.is_bigendian != first.is_bigendian
                   for c in clouds[1:]):
                raise ValueError('camera point cloud field layouts differ')
            result = PointCloud2()
            result.header.frame_id = self.target
            result.header.stamp = max((c.header.stamp for c in clouds), key=lambda stamp: (stamp.sec, stamp.nanosec))
            result.height = 1
            result.width = sum(c.width * c.height for c in clouds)
            result.fields = first.fields
            result.is_bigendian = first.is_bigendian
            result.point_step = first.point_step
            result.row_step = result.width * result.point_step
            result.is_dense = all(c.is_dense for c in clouds)
            result.data = b''.join(transform_cloud_data(cloud, transform)
                                   for cloud, transform in zip(clouds, transforms))
            self.publisher.publish(result)
        except (ValueError, AssertionError, TypeError) as exc:
            self.get_logger().warning(f'Dropping incompatible point clouds: {exc}', throttle_duration_sec=5.0)


def main():
    rclpy.init()
    node = None
    try:
        node = CloudFusion()
        rclpy.spin(node)
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
