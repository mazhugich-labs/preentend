<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="end_effector_nozzle_link" params="prefix index">
        <link name="${prefix}end_effector_nozzle_${index}">
            <inertial>
                <mass value="0.0257511" />
                <origin xyz="-3.71835e-19 -1.24009e-35 0.0389773" rpy="0 -0 0" />
                <inertia ixx="1.37015e-05" ixy="0" ixz="0" iyy="1.37015e-05" iyz="0"
                    izz="1.27138e-06" />
            </inertial>
            <visual>
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/mock_end_effector/end_effector_nozzle.stl" />
                </geometry>
                <material name="light_gray" />
            </visual>
            <collision>
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/mock_end_effector/end_effector_nozzle.stl" />
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <xacro:macro name="end_effector_sensor_link" params="prefix index">
        <link name="${prefix}end_effector_sensor_${index}">
            <inertial>
                <mass value="0.0213081" />
                <origin xyz="-5.61313e-20 -1.15097e-35 0.0347772" rpy="0 -0 0" />
                <inertia ixx="1.22295e-05" ixy="0" ixz="0" iyy="1.22295e-05" iyz="0"
                    izz="9.77537e-07" />
            </inertial>
            <visual>
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/mock_end_effector/end_effector_sensor.stl" />
                </geometry>
                <material name="dark_gray" />
            </visual>
            <collision>
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/mock_end_effector/end_effector_sensor.stl" />
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <xacro:macro name="end_effector"
        params="prefix:='' 
        parent *origin 
        use_gazebo:='false'">
        <xacro:if value="${use_gazebo}">
            <xacro:include
                filename="$(find preentend_description)/urdf/end_effector/mock.gazebo.xacro" />
            <xacro:end_effector_gazebo prefix="${prefix}" />
        </xacro:if>

        <link name="${prefix}end_effector_origin" />
        <joint name="${prefix}end_effector_origin_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}end_effector_origin" />
        </joint>

        <link name="${prefix}end_effector_base_link">
            <inertial>
                <mass value="1.40889" />
                <origin xyz="0.104998 2.10691e-17 -0.0977302" rpy="0 -0 0" />
                <inertia ixx="0.0377398" ixy="0" ixz="0.00470496" iyy="0.0379017" iyz="0"
                    izz="0.00790301" />
            </inertial>
            <visual>
                <origin xyz="0.02 0 -1.74512e-18" rpy="0 -0 0" />
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/mock_end_effector/end_effector_base.stl" />
                </geometry>
                <material name="gray" />
            </visual>
            <collision>
                <origin xyz="0.02 0 -1.74512e-18" rpy="0 -0 0" />
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/mock_end_effector/end_effector_base.stl" />
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}end_effector_origin_to_base_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="${prefix}end_effector_origin"/>
            <child link="${prefix}end_effector_base_link"/>
        </joint>

        <xacro:end_effector_nozzle_link prefix="${prefix}" index="1" />
        <xacro:end_effector_nozzle_link prefix="${prefix}" index="2" />
        <xacro:end_effector_nozzle_link prefix="${prefix}" index="3" />
        <xacro:end_effector_nozzle_link prefix="${prefix}" index="4" />
        <xacro:end_effector_nozzle_link prefix="${prefix}" index="5" />
        <xacro:end_effector_nozzle_link prefix="${prefix}" index="6" />
        <xacro:end_effector_nozzle_link prefix="${prefix}" index="7" />
        <xacro:end_effector_nozzle_link prefix="${prefix}" index="8" />
        <joint name="${prefix}eef_nozzle_j1" type="fixed">
            <origin xyz="0.135 -0.0475 0.035" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_nozzle_1" />
        </joint>
        <joint name="${prefix}eef_nozzle_j2" type="fixed">
            <origin xyz="0.135 0.0475 0.035" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_nozzle_2" />
        </joint>
        <joint name="${prefix}eef_nozzle_j3" type="fixed">
            <origin xyz="0.135 -0.0475 -0.095" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_nozzle_3" />
        </joint>
        <joint name="${prefix}eef_nozzle_j4" type="fixed">
            <origin xyz="0.135 0.0475 -0.095" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_nozzle_4" />
        </joint>
        <joint name="${prefix}eef_nozzle_j5" type="fixed">
            <origin xyz="0.135 -0.0475 -0.225" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_nozzle_5" />
        </joint>
        <joint name="${prefix}eef_nozzle_j6" type="fixed">
            <origin xyz="0.135 0.0475 -0.225" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_nozzle_6" />
        </joint>
        <joint name="${prefix}eef_nozzle_j7" type="fixed">
            <origin xyz="0.135 -0.0475 -0.355" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_nozzle_7" />
        </joint>
        <joint name="${prefix}eef_nozzle_j8" type="fixed">
            <origin xyz="0.135 0.0475 -0.355" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_nozzle_8" />
        </joint>

        <xacro:end_effector_sensor_link prefix="${prefix}" index="1" />
        <xacro:end_effector_sensor_link prefix="${prefix}" index="2" />
        <xacro:end_effector_sensor_link prefix="${prefix}" index="3" />
        <xacro:end_effector_sensor_link prefix="${prefix}" index="4" />
        <xacro:end_effector_sensor_link prefix="${prefix}" index="5" />
        <xacro:end_effector_sensor_link prefix="${prefix}" index="6" />
        <joint name="${prefix}eef_sensor_j1" type="fixed">
            <origin xyz="0.135 -0.04 0.095" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_sensor_1" />
        </joint>
        <joint name="${prefix}eef_sensor_j2" type="fixed">
            <origin xyz="0.135 0.04 0.095" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_sensor_2" />
        </joint>
        <joint name="${prefix}eef_sensor_j3" type="fixed">
            <origin xyz="0.135 -0.115 -0.16" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_sensor_3" />
        </joint>
        <joint name="${prefix}eef_sensor_j4" type="fixed">
            <origin xyz="0.135 0.115 -0.16" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_sensor_4" />
        </joint>
        <joint name="${prefix}eef_sensor_j5" type="fixed">
            <origin xyz="0.135 -0.04 -0.415" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_sensor_5" />
        </joint>
        <joint name="${prefix}eef_sensor_j6" type="fixed">
            <origin xyz="0.135 0.04 -0.415" rpy="0 1.5708 -0" />
            <axis xyz="-0 -0 -1" />
            <parent link="${prefix}end_effector_base_link" />
            <child link="${prefix}end_effector_sensor_6" />
        </joint>
    </xacro:macro>
</robot>
