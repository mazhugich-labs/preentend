<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="end_effector"
        params="prefix:='' 
        parent *origin 
        use_gazebo:='false'">
        <xacro:if value="${use_gazebo}">
            <xacro:include
                filename="$(find preentend_description)/urdf/end_effector/mock.gazebo.xacro" />
            <xacro:end_effector_gazebo prefix="${prefix}" />
        </xacro:if>

        <link name="${prefix}end_effector_origin" />
        <joint name="${prefix}end_effector_origin_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}end_effector_origin" />
        </joint>

        <link name="${prefix}end_effector_link">
            <inertial>
                <mass value="7.64194537" />
                <origin xyz="0.187 0.006 0.107" rpy="0 0 0" />
                <inertia
                    ixx="0.22947645" ixy="-0.0008385942" ixz="-0.04206259245"
                    iyy="0.26544120677" iyz="-0.00201348558"
                    izz="0.07870317635" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/end_effector/mock_end_effector.stl" />
                </geometry>
                <material name="gray" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://preentend_description/meshes/end_effector/mock_end_effector.stl" />
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}end_effector_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${prefix}end_effector_origin" />
            <child link="${prefix}end_effector_link" />
        </joint>

        <link name="${prefix}tcp" />
        <joint name="${prefix}tcp_joint" type="fixed">
            <origin xyz="0.344 0 0.155" rpy="0 0 0" />
            <parent link="${prefix}end_effector_link" />
            <child link="${prefix}tcp" />
        </joint>
    </xacro:macro>
</robot>