<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="m20_12_23d_joint_transmission"
    params="prefix joint hardware_interface mechanical_reduction">
    <transmission name="${prefix}${joint}_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}${joint}">
        <hardwareInterface>${hardware_interface}</hardwareInterface>
      </joint>
      <actuator name="${prefix}${joint}_motor">
        <hardwareInterface>${hardware_interface}</hardwareInterface>
        <mechanicalReduction>${mechanical_reduction}</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:macro name="m20_12_23d_transmissions"
    params="prefix:='' hardware_interface:='hardware_interface/PositionJointInterface' mechanical_reduction:=1">
    <xacro:m20_12_23d_joint_transmission prefix="${prefix}" joint="J1"
      hardware_interface="${hardware_interface}" mechanical_reduction="${mechanical_reduction}" />
    <xacro:m20_12_23d_joint_transmission prefix="${prefix}" joint="J2"
      hardware_interface="${hardware_interface}" mechanical_reduction="${mechanical_reduction}" />
    <xacro:m20_12_23d_joint_transmission prefix="${prefix}" joint="J3"
      hardware_interface="${hardware_interface}" mechanical_reduction="${mechanical_reduction}" />
    <xacro:m20_12_23d_joint_transmission prefix="${prefix}" joint="J4"
      hardware_interface="${hardware_interface}" mechanical_reduction="${mechanical_reduction}" />
    <xacro:m20_12_23d_joint_transmission prefix="${prefix}" joint="J5"
      hardware_interface="${hardware_interface}" mechanical_reduction="${mechanical_reduction}" />
    <xacro:m20_12_23d_joint_transmission prefix="${prefix}" joint="J6"
      hardware_interface="${hardware_interface}" mechanical_reduction="${mechanical_reduction}" />
  </xacro:macro>
</robot>
