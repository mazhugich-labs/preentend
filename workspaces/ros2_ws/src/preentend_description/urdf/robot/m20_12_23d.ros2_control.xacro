<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="m20_12_23d_ros2_control_joint" params="prefix joint">
        <joint name="${prefix}${joint}">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </xacro:macro>

    <xacro:macro name="m20_12_23d_ros2_control"
        params="prefix:='' hardware_plugin:='mock_components/GenericSystem'">
        <ros2_control name="${prefix}m20_12_23d" type="system">
            <hardware>
                <plugin>${hardware_plugin}</plugin>
            </hardware>
            <xacro:m20_12_23d_ros2_control_joint prefix="${prefix}" joint="J1" />
            <xacro:m20_12_23d_ros2_control_joint prefix="${prefix}" joint="J2" />
            <xacro:m20_12_23d_ros2_control_joint prefix="${prefix}" joint="J3" />
            <xacro:m20_12_23d_ros2_control_joint prefix="${prefix}" joint="J4" />
            <xacro:m20_12_23d_ros2_control_joint prefix="${prefix}" joint="J5" />
            <xacro:m20_12_23d_ros2_control_joint prefix="${prefix}" joint="J6" />
        </ros2_control>
    </xacro:macro>
</robot>
