<?xml version="1.0"?>
<!--
Static car. The mesh is centered on the model origin, rests on z = 0 and has its length
along x (heading along +x or -x depends on the source mesh). Collision is the mesh bounding box.
Bounding box: 3.87 x 1.73 x 1.24 m.
-->
<sdf version="1.9">
  <model name="car_018">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.6176 0 0 0</pose>
        <geometry>
          <box>
            <size>3.8742 1.7272 1.2351</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>-0.0143 -0.0000 0.6176 0 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://car_018/meshes/car_018.dae</uri>
            <scale>30 30 30</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
