<?xml version="1.0"?>
<!--
Static car. The mesh is centered on the model origin, rests on z = 0 and has its length
along x (heading along +x or -x depends on the source mesh). Collision is the mesh bounding box.
Bounding box: 4.27 x 1.83 x 1.64 m.
-->
<sdf version="1.9">
  <model name="car_121">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.8214 0 0 0</pose>
        <geometry>
          <box>
            <size>4.2727 1.8284 1.6428</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>2.1309 -0.0000 -0.0000 0 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://car_121/meshes/car_121.dae</uri>
            <scale>0.035 0.035 0.035</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
