<?xml version="1.0"?>
<!--
Static car. The mesh is centered on the model origin, rests on z = 0 and has its length
along x (heading along +x or -x depends on the source mesh). Collision is the mesh bounding box.
Bounding box: 3.78 x 1.76 x 1.36 m.
-->
<sdf version="1.9">
  <model name="car_lexus">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.6823 0 0 0</pose>
        <geometry>
          <box>
            <size>3.7768 1.7605 1.3645</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0.0106 0.0037 -0.0122 0 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://car_lexus/meshes/Lexus.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
