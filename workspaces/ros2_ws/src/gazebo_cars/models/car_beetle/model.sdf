<?xml version="1.0"?>
<!--
Static car. The mesh is centered on the model origin, rests on z = 0 and has its length
along x (heading along +x or -x depends on the source mesh). Collision is the mesh bounding box.
Bounding box: 3.35 x 1.55 x 1.43 m.
-->
<sdf version="1.9">
  <model name="car_beetle">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.7170 0 0 0</pose>
        <geometry>
          <box>
            <size>3.3535 1.5482 1.4341</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>-0.1059 -0.3661 -0.0000 0 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://car_beetle/meshes/beetle.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
