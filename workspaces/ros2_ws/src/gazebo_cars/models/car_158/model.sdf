<?xml version="1.0"?>
<!--
Static car. The mesh is centered on the model origin, rests on z = 0 and has its length
along x (heading along +x or -x depends on the source mesh). Collision is the mesh bounding box.
Bounding box: 2.62 x 1.28 x 0.91 m.
-->
<sdf version="1.9">
  <model name="car_158">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.4540 0 0 0</pose>
        <geometry>
          <box>
            <size>2.6242 1.2827 0.9081</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0.0021 0.0005 0.4509 0 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://car_158/meshes/car_158.dae</uri>
            <scale>25 25 25</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
