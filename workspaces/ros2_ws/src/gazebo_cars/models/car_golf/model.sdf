<?xml version="1.0"?>
<!--
Static car. The mesh is centered on the model origin, rests on z = 0 and has its length
along x (heading along +x or -x depends on the source mesh). Collision is the mesh bounding box.
Bounding box: 4.21 x 1.96 x 1.50 m.
-->
<sdf version="1.9">
  <model name="car_golf">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.7487 0 0 0</pose>
        <geometry>
          <box>
            <size>4.2060 1.9629 1.4974</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>-2.3512 -0.7084 0.0151 0 0 0.000000</pose>
        <geometry>
          <mesh>
            <uri>model://car_golf/meshes/golf.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
