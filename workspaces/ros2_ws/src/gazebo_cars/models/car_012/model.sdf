<?xml version="1.0"?>
<!--
Static car. The mesh is centered on the model origin, rests on z = 0 and has its length
along x (heading along +x or -x depends on the source mesh). Collision is the mesh bounding box.
Bounding box: 3.79 x 1.60 x 1.13 m.
-->
<sdf version="1.9">
  <model name="car_012">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.5648 0 0 0</pose>
        <geometry>
          <box>
            <size>3.7859 1.5976 1.1296</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>-2.0861 0.6210 -0.0056 0 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://car_012/meshes/car_012.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
