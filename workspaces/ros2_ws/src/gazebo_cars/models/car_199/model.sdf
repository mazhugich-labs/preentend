<?xml version="1.0"?>
<!--
Static car. The mesh is centered on the model origin, rests on z = 0 and has its length
along x (heading along +x or -x depends on the source mesh). Collision is the mesh bounding box.
Bounding box: 5.73 x 2.36 x 2.22 m.
-->
<sdf version="1.9">
  <model name="car_199">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 1.1085 0 0 0</pose>
        <geometry>
          <box>
            <size>5.7343 2.3565 2.2171</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>-1.8942 0.5437 -0.0342 0 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://car_199/meshes/car_199.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
